-- ----------------------------
-- 友链表
-- ----------------------------
DROP TABLE IF EXISTS t_friend_link;
CREATE TABLE t_friend_link (
    id          BIGINT       NOT NULL AUTO_INCREMENT COMMENT '友链ID',
    name        VARCHAR(30)  NOT NULL COMMENT '站点名称',
    url         VARCHAR(200) NOT NULL COMMENT '站点地址',
    logo        VARCHAR(300) NULL COMMENT '站点图标',
    description VARCHAR(60)  NULL COMMENT '站点描述',
    status      TINYINT      NOT NULL DEFAULT 0 COMMENT '0待审核 1已上架 2下架',
    sort_order  INT          NOT NULL DEFAULT 0 COMMENT '排序权重',
    create_time DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (id)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_unicode_ci COMMENT '友链表';

