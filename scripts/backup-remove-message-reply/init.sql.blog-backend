-- ----------------------------
-- 留言表
-- ----------------------------
DROP TABLE IF EXISTS t_message;
CREATE TABLE t_message (
    id          BIGINT       NOT NULL AUTO_INCREMENT COMMENT '留言ID',
    user_id     BIGINT       NULL COMMENT '留言人，游客为 NULL',
    nickname    VARCHAR(30)  NULL COMMENT '游客昵称',
    email       VARCHAR(100) NULL COMMENT '游客邮箱（不回显）',
    content     VARCHAR(400) NOT NULL COMMENT '留言内容',
    reply       VARCHAR(400) NULL COMMENT '博主回复',
    reply_time  DATETIME     NULL COMMENT '回复时间',
    ip_location VARCHAR(30)  NULL COMMENT 'IP属地',
    create_time DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (id),
    KEY idx_create (create_time)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_unicode_ci COMMENT '留言表';

