-- ============================================================
-- 简柚个人博客系统 - 数据库初始化脚本
-- 说明：由 docker-compose 首次启动 MySQL 时自动执行
--       （挂载到 /docker-entrypoint-initdb.d/，库已由
--       MYSQL_DATABASE=jianyou_blog 创建并选中，无需 CREATE DATABASE）
-- 手动导入：mysql -ujianyou -p jianyou_blog < init.sql
-- 种子数据为「个人成长记录本」定位的自建内容，前端不再保留任何 mock 数据
-- ============================================================

SET NAMES utf8mb4;

-- ----------------------------
-- 用户表
-- ----------------------------
DROP TABLE IF EXISTS t_user;
CREATE TABLE t_user (
    id          BIGINT       NOT NULL AUTO_INCREMENT COMMENT '用户ID',
    phone       VARCHAR(20)  NULL COMMENT '手机号（与邮箱至少一项，唯一，可用于登录）',
    email       VARCHAR(100) NULL COMMENT '邮箱（与手机号至少一项，唯一，可用于登录）',
    password    VARCHAR(100) NULL COMMENT '密码（BCrypt 密文，由应用启动时写入）',
    nickname    VARCHAR(30)  NOT NULL COMMENT '昵称',
    avatar      VARCHAR(300) NULL COMMENT '头像地址',
    message_bg  VARCHAR(300) NULL COMMENT '留言页自定义背景图地址（NULL=默认夜空）',
    bio         VARCHAR(200) NULL COMMENT '简介',
    gender      TINYINT      NOT NULL DEFAULT 0 COMMENT '性别 0未知 1男 2女',
    role        VARCHAR(10)  NOT NULL DEFAULT 'USER' COMMENT '角色 USER/ADMIN',
    status      TINYINT      NOT NULL DEFAULT 1 COMMENT '状态 0禁用 1正常',
    create_time DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (id),
    UNIQUE KEY uk_phone (phone),
    UNIQUE KEY uk_email (email)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_unicode_ci COMMENT '用户表';

