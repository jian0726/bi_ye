-- ----------------------------
-- 背景音乐表（全站 BGM 歌单，useBgm 启动时从 /portal/music 拉取）
-- ----------------------------
DROP TABLE IF EXISTS t_music;
CREATE TABLE t_music (
    id          BIGINT       NOT NULL AUTO_INCREMENT COMMENT '音乐ID',
    title       VARCHAR(60)  NOT NULL COMMENT '曲名',
    artist      VARCHAR(60)  NULL COMMENT '作者/来源',
    url         VARCHAR(500) NOT NULL COMMENT '音频直链或 MinIO 地址',
    sort_order  INT          NOT NULL DEFAULT 0 COMMENT '排序权重，越小越靠前',
    status      TINYINT      NOT NULL DEFAULT 1 COMMENT '状态 1启用 2停用',
    create_time DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (id),
    KEY idx_music_sort (status, sort_order)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_unicode_ci COMMENT '背景音乐表';

