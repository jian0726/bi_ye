-- ----------------------------
-- 站点配置表（键值对；DB 值覆盖 application.yml 的 site.* 默认值，
-- 管理后台「网站设置」写入此表，无记录的键回落 yml 默认值）
-- ----------------------------
DROP TABLE IF EXISTS t_site_config;
CREATE TABLE t_site_config (
    config_key   VARCHAR(50)   NOT NULL COMMENT '配置键（与 site.* kebab-case 一致，如 site-name）',
    config_value VARCHAR(2000) NULL COMMENT '配置值',
    update_time  DATETIME      NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (config_key)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_unicode_ci COMMENT '站点配置表';

-- ----------------------------
-- 相册照片表（url 为空时前台用 tone 渐变 + emoji 占位）
-- ----------------------------
DROP TABLE IF EXISTS t_photo;
CREATE TABLE t_photo (
    id          BIGINT       NOT NULL AUTO_INCREMENT COMMENT '照片ID',
    title       VARCHAR(60)  NOT NULL COMMENT '标题',
    url         VARCHAR(500) NULL COMMENT '图片地址（MinIO）；空=渐变占位',
    location    VARCHAR(60)  NULL COMMENT '拍摄地点',
    taken_date  DATE         NULL COMMENT '拍摄日期',
    ratio       VARCHAR(10)  NOT NULL DEFAULT '1/1' COMMENT '宽高比（如 3/4），瀑布流占位用',
    tone        VARCHAR(120) NULL COMMENT '占位渐变色（url 为空时显示）',
    emoji       VARCHAR(10)  NULL COMMENT '占位 emoji',
    sort_order  INT          NOT NULL DEFAULT 0 COMMENT '排序权重，越小越靠前',
    status      TINYINT      NOT NULL DEFAULT 1 COMMENT '状态 1显示 2隐藏',
    create_time DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (id),
    KEY idx_photo_sort (status, sort_order)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_unicode_ci COMMENT '相册照片表';

