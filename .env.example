# ============================================
# 简柚博客 - 环境变量示例文件
# --------------------------------------------
# 用法：
#   1. 复制本文件为 .env         cp .env.example .env
#   2. 把下面所有 CHANGE_ME_* 改成你自己的强密码
#   3. docker compose up -d
#
# 生成随机密码（任选一条执行）：
#   Linux/macOS:  openssl rand -base64 32
#   Windows:      powershell -c "[Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))"
#   在线:          https://www.random.org/passwords/
#
# ⚠️ .env 已被 .gitignore 忽略，千万不要提交到仓库
# ⚠️ JWT_SECRET 至少 32 字符，否则后端启动会失败（防止用弱密钥签发令牌）
# ============================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root
MYSQL_DATABASE=jianyou_blog
MYSQL_USER=jianyou
MYSQL_PASSWORD=CHANGE_ME_mysql_user

# ---------- Redis ----------
# 容器内 Redis 已开启 requirepass，留空会导致 compose 拒绝启动
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------- MinIO 对象存储 ----------
MINIO_ROOT_USER=jianyou_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# ---------- 应用安全 ----------
# JWT 签名密钥：至少 32 字符，改动后所有已登录用户需重新登录
JWT_SECRET=CHANGE_ME_at_least_32_chars_long_random_string

# ---------- 验证码通道 ----------
# true  = 开发模式，验证码随接口响应返回（仅本地调试可用）
# false = 生产模式，验证码不返回（当前未接入短信/邮件，找回密码功能实际不可用）
VERIFY_DEV_MODE=false

# ---------- 端口映射 ----------
# 本机 8080/5174 若被占用，改这里即可
BACKEND_PORT=8081
FRONTEND_PORT=5174

# ---------- 访问日志 ----------
VISIT_LOG_RETENTION_DAYS=90
VISIT_LOG_PURGE_CRON=0 0 4 * * ?
