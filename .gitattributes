# 统一按 LF 存入仓库：避免 Windows 检出 CRLF 后
# Dockerfile / shell 脚本 / nginx 配置在 Linux 容器的 shebang、指令解析上出错
* text=auto eol=lf

*.sh    text eol=lf
*.ps1   text eol=lf
*.cmd   text eol=lf
*.bat   text eol=crlf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile        text eol=lf
*.conf  text eol=lf

*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.docx  binary
*.doc   binary
*.xlsx  binary
*.pdf   binary
*.xdb   binary
